# Copie este arquivo para .env e preencha com seus dados do Supabase
# Acesse: https://supabase.com → seu projeto → Settings → API

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Notificações push do Portal do Cliente — chave pública VAPID (gere um par
# com `npx web-push generate-vapid-keys`; a chave PRIVADA vai só na Vercel,
# nunca aqui: VAPID_PUBLIC_KEY e VAPID_PRIVATE_KEY)
VITE_VAPID_PUBLIC_KEY=sua_chave_publica_vapid_aqui
